{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://zomato-concierge-api.vercel.app/api/:match*"
    },
    {
      "source": "/health",
      "destination": "https://zomato-concierge-api.vercel.app/health"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/((?!api|health).*)",
      "destination": "/frontend/$1"
    }
  ]
}
